# ── WhatsApp (always required) ───────────────────────────
# Your own number in international format, no +, no spaces.
# The self-chat ("Message Yourself") JID is your own number @s.whatsapp.net
# Example for a US number: WHATSAPP_SELF_JID=1234567890@s.whatsapp.net
WHATSAPP_SELF_JID=

# ── Optional: WhatsApp Group Chat Destination ────────────
# Specify either the group name (case-insensitive) OR its exact JID:
# 1. By name (e.g. WHATSAPP_GROUP_NAME="FB Posts Inbox")
WHATSAPP_GROUP_NAME=
# 2. Or by exact JID (e.g. 120363028374628374@g.us; send "#group <name>" to find it)
WHATSAPP_GROUP_JID=
# Allow anyone in the group to post (true), or only messages sent by your account (false, default).
WHATSAPP_GROUP_ALLOW_ALL=false



# ── Posting provider: graph | buffer ─────────────────────
# graph  = direct Facebook Graph API (needs a free Meta developer app, one-time ~15 min)
# buffer = via Buffer (BIG RECOMMENDED — NO Meta app needed; free plan has API access)
#          Get your API key at https://publish.buffer.com → Settings → API
POSTING_PROVIDER=buffer

# ── Buffer mode ──────────────────────────────────────────
BUFFER_API_KEY=
# Optional — pinned org/channel. If empty, auto-detected when unambiguous
# (send "#profiles" to the bot to see ids; set these when you have several pages).
BUFFER_ORG_ID=
BUFFER_CHANNEL_ID=

# ── Graph API mode (only used if POSTING_PROVIDER=graph) ─
FB_PAGE_ID=
FB_PAGE_TOKEN=
# Long-lived page token. Leave default unless you know better.
FB_API_VERSION=v21.0

# ── Media Auto-Delete (Optional) ─────────────────────────
# Get your free userhash from https://catbox.moe
# Enables automatic deletion of temporary photos 10 minutes after posting
CATBOX_USERHASH=

# ── Optional ─────────────────────────────────────────────
# Set a PORT to expose a tiny health endpoint (useful on Render/Fly/Railway).
PORT=